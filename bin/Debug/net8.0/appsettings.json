{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ReverseProxy": {
    "Routes": {
      "user-service-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "user-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7057/"
          }
        }
      }
    }
  },

  "AllowedHosts": "*"
}