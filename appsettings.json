{
  "ReverseProxy": {
    "Routes": {

      "user-login": {
        "ClusterId": "user-service",

        "Match": {
          "Path": "/api/users/auth/login",
          "Methods": [ "POST" ]
        },

        "Transforms": [
          {
            "PathPattern": "/api/Auth/login"
          }
        ]
      },

      "user-google-login": {
        "ClusterId": "user-service",
        "Match": {
          "Path": "/api/users/auth/google",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          {
            "PathPattern": "/api/Auth/google"
          }
        ]
      },

      "user-register": {
        "ClusterId": "user-service",

        "Match": {
          "Path": "/api/users/auth/register",
          "Methods": [ "POST" ]
        },

        "Transforms": [
          {
            "PathPattern": "/api/Auth/register"
          }
        ]
      },

      "user-verify-email": {
        "ClusterId": "user-service",

        "Match": {
          "Path": "/api/users/auth/verify-email",
          "Methods": [ "GET" ]
        },

        "Transforms": [
          {
            "PathPattern": "/api/Auth/verify-email"
          }
        ]
      },

      "user-resend-verification": {
        "ClusterId": "user-service",

        "Match": {
          "Path": "/api/users/auth/resend-verification",
          "Methods": [ "POST" ]
        },

        "Transforms": [
          {
            "PathPattern": "/api/Auth/resend-verification"
          }
        ]
      },

      "user-me": {
        "ClusterId": "user-service",

        "AuthorizationPolicy": "authenticated",

        "Match": {
          "Path": "/api/users/auth/me",
          "Methods": [ "GET" ]
        },

        "Transforms": [
          {
            "PathPattern": "/api/Auth/me"
          }
        ]
      },

     "order-service": {
  "ClusterId": "order-service",
  "AuthorizationPolicy": "authenticated",
  "Match": {
    "Path": "/api/orders/{**catch-all}",
    "Methods": [ "GET", "POST", "PUT" ]
  }
},

        "payment-service": {
          "ClusterId": "payment-service",
          "AuthorizationPolicy": "authenticated",
          "Match": {
            "Path": "/api/payments/{**catch-all}",
            "Methods": [ "GET", "POST" ]
          }
        },

       

      "product-service": {
        "ClusterId": "product-service",

        "Match": {
          "Path": "/api/products/{**catch-all}"
        },

        "Transforms": [
          {
            "PathPattern": "/api/Product/{**catch-all}"
          }
        ]
      }
    },

    "Clusters": {

      "user-service": {
        "Destinations": {
          "user-service": {
            "Address": "http://localhost:5230/"
          }
        }
      },

      "order-service": {
        "Destinations": {
          "order-service": {
            "Address": "http://localhost:5280/"
          }
        }
      },

      "payment-service": {
        "Destinations": {
          "payment-service": {
            "Address": "http://localhost:5270/"
          }
        }
      },

      "product-service": {
        "Destinations": {
          "product-service": {
            "Address": "http://localhost:5148/"
          }
        }
      }
    }
  }
}