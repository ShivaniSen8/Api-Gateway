{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ReverseProxy": {
    "Routes": {
      "user-service-auth-route": {
        "ClusterId": "user-service-cluster",

        "Match": {
          "Path": "/api/users/auth/{**catch-all}"
        },

        "Transforms": [
          {
            "PathPattern": "/api/Auth/{**catch-all}"
          }
        ]
      }
    },

    "Clusters": {
      "user-service-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "https://localhost:7057/"
          }
        }
      }
    }
  },

  "AllowedHosts": "*"
}